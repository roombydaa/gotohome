  const ensureAdminPuzzle = (state) => {
    if(state.random.adminPuzzle) return state.random.adminPuzzle;
    const digits = [...state.random.adminDigits];
    const keys = ['mail','approval','files','handover'];
    const mapping = {};
    keys.forEach((k,i)=>mapping[k]=digits[i]);

    const listOrder = shuffled(keys);
    let sequence = shuffled(keys);
    // 아이콘 순서가 식별코드 목록 순서와 같으면 다시 섞어서 퍼즐성이 사라지지 않게 함.
    let guard=0;
    while(sequence.join('|')===listOrder.join('|') && guard<20){
      sequence=shuffled(keys);
      guard++;
    }
    // 그래도 같다면 강제로 한 칸 회전
    if(sequence.join('|')===listOrder.join('|')){
      sequence=[...listOrder.slice(1),listOrder[0]];
    }

    const answer = sequence.map(k=>mapping[k]).join('');
    state.random.adminPuzzle = {mapping,listOrder,sequence,answer};
    saveState(state);
    return state.random.adminPuzzle;
  };

