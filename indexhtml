<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>index?</title>
<style>
  :root{
    --bg:#f4f5ff;
    --surface:#ffffff;
    --surface-soft:#f8f8ff;
    --text:#23263a;
    --muted:#7d8197;
    --line:#e8e9f3;
    --primary:#7868f3;
    --primary-2:#9a8cff;
    --primary-soft:#ece9ff;
    --nav:#ffffff;
    --success:#53b693;
    --shadow:0 16px 40px rgba(84,76,154,.12);
    --radius:24px;
  }

  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%;font-family:Inter, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;background:var(--bg);color:var(--text)}
  body{min-height:100dvh}
  button,input{font:inherit}

  .app{
    min-height:100dvh;
    max-width:520px;
    margin:0 auto;
    background:
      radial-gradient(circle at 15% 5%, rgba(138,123,255,.13), transparent 28%),
      radial-gradient(circle at 92% 8%, rgba(110,166,255,.11), transparent 24%),
      var(--bg);
    position:relative;
    overflow-x:hidden;
  }

  .screen{display:none;min-height:100dvh}
  .screen.active{display:flex;flex-direction:column}

  .login-screen{
    padding:28px 22px max(30px, env(safe-area-inset-bottom));
    justify-content:center;
  }

  .login-shell{
    width:100%;
    background:var(--surface);
    border-radius:32px;
    box-shadow:var(--shadow);
    overflow:hidden;
    border:1px solid rgba(124,109,245,.08);
  }

  .login-visual{
    min-height:250px;
    padding:30px 26px 24px;
    background:linear-gradient(145deg,#f0efff 0%,#f7f7ff 54%,#eef7ff 100%);
    display:flex;
    flex-direction:column;
    justify-content:space-between;
  }

  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:800;
    letter-spacing:.02em;
    color:#312f5b;
  }

  .brand-mark{
    width:32px;height:32px;border-radius:11px;
    background:linear-gradient(135deg,var(--primary),#a9a1ff);
    position:relative;
    box-shadow:0 8px 18px rgba(120,104,243,.25);
  }
  .brand-mark:before,.brand-mark:after{
    content:"";position:absolute;background:#fff;border-radius:6px;
  }
  .brand-mark:before{width:8px;height:8px;left:7px;top:7px;box-shadow:10px 0 0 #fff,0 10px 0 #fff,10px 10px 0 #fff}
  .brand-mark:after{display:none}

  .desk-art{
    margin:18px auto 0;
    width:190px;height:130px;
    position:relative;
  }
  .monitor{position:absolute;left:42px;top:6px;width:108px;height:70px;border-radius:13px;background:#fff;box-shadow:0 12px 25px rgba(90,88,150,.12);border:1px solid #e4e4f3}
  .monitor:before{content:"";position:absolute;left:50%;bottom:-18px;width:8px;height:18px;background:#cfd2e7;transform:translateX(-50%)}
  .monitor:after{content:"";position:absolute;left:50%;bottom:-23px;width:42px;height:7px;border-radius:8px;background:#d8dbea;transform:translateX(-50%)}
  .screen-lines{position:absolute;left:56px;top:21px;width:80px;height:40px}
  .screen-lines i{display:block;height:7px;border-radius:8px;margin:0 0 7px;background:#dcd8ff}
  .screen-lines i:nth-child(2){width:62px;background:#e8e7f5}
  .screen-lines i:nth-child(3){width:45px;background:#ecebf7}
  .desk{position:absolute;left:18px;right:18px;bottom:8px;height:12px;border-radius:7px;background:#c8b79e}
  .cup{position:absolute;right:20px;bottom:25px;width:26px;height:30px;border-radius:7px 7px 10px 10px;background:#8bb8ff}
  .plant{position:absolute;left:12px;bottom:23px;width:26px;height:23px;background:#f0b488;border-radius:4px 4px 8px 8px}
  .plant:before,.plant:after{content:"";position:absolute;width:18px;height:32px;border-radius:50%;background:#76c5a3;bottom:13px}
  .plant:before{left:-3px;transform:rotate(-24deg)}
  .plant:after{right:-4px;transform:rotate(28deg)}

  .login-copy h1{
    margin:0;
    font-size:28px;
    line-height:1.25;
    letter-spacing:-.04em;
  }
  .login-copy p{
    margin:10px 0 0;
    color:var(--muted);
    line-height:1.65;
    font-size:14px;
  }

  .login-form{
    padding:28px 24px 26px;
  }
  .eyebrow{
    color:var(--primary);
    font-weight:800;
    font-size:12px;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  .login-form h2{
    margin:8px 0 6px;
    font-size:24px;
    letter-spacing:-.04em;
  }
  .login-form .desc{
    color:var(--muted);
    font-size:14px;
    margin:0 0 20px;
  }
  .field-label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:8px;
  }
  .name-input{
    width:100%;
    height:54px;
    border:1px solid var(--line);
    border-radius:16px;
    padding:0 16px;
    outline:none;
    background:#fbfbff;
    color:var(--text);
    transition:.2s;
  }
  .name-input:focus{
    border-color:#b7adff;
    box-shadow:0 0 0 4px rgba(120,104,243,.1);
    background:#fff;
  }
  .primary-btn{
    width:100%;
    height:54px;
    border:none;
    border-radius:16px;
    margin-top:14px;
    color:white;
    font-weight:800;
    background:linear-gradient(135deg,var(--primary),#8f7eff);
    box-shadow:0 12px 24px rgba(120,104,243,.25);
    cursor:pointer;
  }
  .primary-btn:active{transform:translateY(1px)}
  .helper{
    margin:14px 0 0;
    text-align:center;
    color:#9699aa;
    font-size:12px;
  }

  /* HOME */
  .home-screen{
    padding-bottom:calc(86px + env(safe-area-inset-bottom));
  }
  .topbar{
    height:72px;
    padding:16px 18px 10px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .top-actions{display:flex;align-items:center;gap:8px}
  .icon-btn{
    width:40px;height:40px;border-radius:14px;border:1px solid var(--line);
    background:#ffffffcc;display:grid;place-items:center;color:#4b506b;cursor:pointer;
  }
  .avatar{
    width:40px;height:40px;border-radius:14px;background:var(--primary-soft);
    display:grid;place-items:center;font-size:14px;font-weight:800;color:var(--primary);
  }

  .content{padding:8px 18px 26px}
  .greeting{
    background:linear-gradient(135deg,#ffffff 0%,#f4f1ff 56%,#edf6ff 100%);
    border:1px solid rgba(120,104,243,.08);
    border-radius:26px;
    padding:22px;
    box-shadow:0 12px 30px rgba(84,76,154,.08);
    display:flex;
    justify-content:space-between;
    gap:12px;
  }
  .greeting h2{margin:0;font-size:22px;letter-spacing:-.04em}
  .greeting p{margin:8px 0 0;color:var(--muted);font-size:13px;line-height:1.5}
  .mini-illustration{
    width:86px;min-width:86px;height:72px;border-radius:20px;background:#edeaff;position:relative;
  }
  .mini-illustration:before{content:"";position:absolute;left:23px;top:16px;width:42px;height:28px;border-radius:7px;background:white;border:1px solid #d9d6f5}
  .mini-illustration:after{content:"☕";position:absolute;left:8px;bottom:4px;font-size:24px}

  .section-head{
    display:flex;align-items:flex-end;justify-content:space-between;
    margin:26px 4px 12px;
  }
  .section-head h3{margin:0;font-size:20px;letter-spacing:-.03em}
  .progress-label{font-weight:800;color:var(--primary);font-size:14px}
  .progress-track{
    width:100%;height:8px;border-radius:999px;background:#e7e6f3;overflow:hidden;margin:0 0 16px;
  }
  .progress-fill{
    height:100%;width:0%;background:linear-gradient(90deg,var(--primary),var(--primary-2));border-radius:inherit;
    transition:width .35s ease;
  }

  .task-list{display:flex;flex-direction:column;gap:12px}
  .task-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:20px;
    padding:15px;
    display:flex;
    align-items:center;
    gap:13px;
    box-shadow:0 8px 18px rgba(77,74,124,.05);
    cursor:pointer;
  }
  .task-card:active{transform:scale(.995)}
  .task-icon{
    width:48px;height:48px;border-radius:16px;background:var(--primary-soft);
    display:grid;place-items:center;font-size:23px;flex:0 0 auto;
  }
  .task-meta{min-width:0;flex:1}
  .task-title{font-weight:800;font-size:15px}
  .task-desc{margin-top:4px;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .task-state{
    font-size:12px;font-weight:800;color:#9a9db0;
  }

  .placeholder{
    margin-top:18px;
    padding:17px;
    border-radius:18px;
    background:#ffffffa8;
    border:1px dashed #d9d9e8;
    color:#9295a8;
    text-align:center;
    font-size:12px;
    line-height:1.6;
  }

  .bottom-nav{
    position:fixed;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(520px,100%);
    height:calc(72px + env(safe-area-inset-bottom));
    padding:8px 12px env(safe-area-inset-bottom);
    background:rgba(255,255,255,.94);
    backdrop-filter:blur(18px);
    border-top:1px solid var(--line);
    display:grid;
    grid-template-columns:repeat(5,1fr);
    z-index:20;
  }
  .nav-btn{
    border:0;background:transparent;color:#9498aa;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:4px;font-size:10px;font-weight:700;cursor:pointer;border-radius:14px;
  }
  .nav-btn .nav-icon{font-size:21px;line-height:1}
  .nav-btn.active{color:var(--primary);background:var(--primary-soft)}

  .toast{
    position:fixed;left:50%;bottom:92px;transform:translate(-50%,20px);
    background:#292d42;color:#fff;padding:11px 16px;border-radius:14px;
    font-size:12px;opacity:0;pointer-events:none;transition:.25s;z-index:30;
    max-width:calc(100% - 40px);text-align:center;
  }
  .toast.show{opacity:1;transform:translate(-50%,0)}


  .work-panel-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:0 10px 24px rgba(77,74,124,.07)}
  .work-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}
  .work-head h3{margin:0;font-size:19px}.back-btn{border:0;background:var(--primary-soft);color:var(--primary);border-radius:12px;padding:9px 12px;font-weight:800}
  .mail-item,.file-item,.doc-box{border:1px solid var(--line);background:#fbfbff;border-radius:16px;padding:14px;margin:10px 0}
  .mail-item strong,.file-item strong{display:block;margin-bottom:5px}.small{font-size:12px;color:var(--muted);line-height:1.55}.body-copy{font-size:14px;line-height:1.7;margin:12px 0;color:#3d4158}
  .choice-grid{display:grid;gap:9px;margin-top:12px}.choice{border:1px solid var(--line);background:white;border-radius:14px;padding:13px;text-align:left;font-weight:700;color:var(--text)}.choice.selected{border-color:#a99eff;background:var(--primary-soft);color:#5445c7}
  .action-btn{width:100%;height:50px;border:0;border-radius:15px;background:linear-gradient(135deg,var(--primary),#8f7eff);color:white;font-weight:800;margin-top:12px}.action-btn.secondary{background:#f0eff9;color:#5f6275;box-shadow:none}.action-btn:disabled{opacity:.45}
  .num-seq{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0}.num-chip{min-width:50px;padding:11px 10px;border-radius:13px;background:var(--primary-soft);text-align:center;font-weight:900;color:#5749c9}.answer-input{width:100%;height:50px;border:1px solid var(--line);border-radius:14px;padding:0 14px;outline:none;background:#fff}.answer-input:focus{border-color:#aaa0ff;box-shadow:0 0 0 4px rgba(120,104,243,.09)}
  .folder-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.folder{padding:12px 5px;border:1px solid var(--line);border-radius:14px;background:#fff;text-align:center;font-size:12px;font-weight:800}.file-item{cursor:pointer}.file-item.selected{border-color:#a99eff;background:var(--primary-soft)}
  .hint-tag{display:inline-block;padding:5px 8px;border-radius:9px;background:#f1efff;color:#6657d7;font-size:11px;font-weight:800;margin-top:7px}.success-box{padding:16px;border-radius:16px;background:#edf9f5;color:#28765e;font-weight:800;text-align:center;margin-top:12px}

  body.theme-evening{
    --bg:#e5e6ec;
    --surface:#f5f5f7;
    --surface-soft:#ececf0;
    --text:#252832;
    --muted:#747985;
    --line:#d5d7de;
    --primary:#6f6b8e;
    --primary-2:#8f8aa9;
    --primary-soft:#e3e2ea;
    --nav:#eeeeF2;
    --shadow:0 16px 40px rgba(48,50,60,.12);
  }
  body.theme-evening .app{
    background:
      radial-gradient(circle at 15% 5%, rgba(91,88,120,.10), transparent 28%),
      radial-gradient(circle at 92% 8%, rgba(80,91,110,.08), transparent 24%),
      var(--bg);
    transition:background .55s ease,color .55s ease;
  }
  body.theme-evening .greeting{background:linear-gradient(135deg,#f7f7f8 0%,#eeeeF2 55%,#e9ebef 100%)}
  body.theme-evening .bottom-nav{background:rgba(239,239,243,.96)}
  .checkout-wrap{margin-top:18px}
  .checkout-btn{
    width:100%;height:56px;border:0;border-radius:18px;
    background:linear-gradient(135deg,#6e61e9,#8c7cf8);
    color:#fff;font-weight:900;font-size:16px;
    box-shadow:0 12px 26px rgba(110,97,233,.24);cursor:pointer;
  }
  .overlay{
    position:fixed;inset:0;background:rgba(30,32,45,.38);
    display:none;align-items:center;justify-content:center;
    padding:22px;z-index:100;backdrop-filter:blur(6px);
  }
  .overlay.show{display:flex}
  .modal{
    width:min(420px,100%);background:#fff;border-radius:26px;padding:24px;
    box-shadow:0 28px 70px rgba(30,30,55,.24);border:1px solid rgba(120,104,243,.10);
  }
  .modal-icon{
    width:58px;height:58px;border-radius:20px;background:var(--primary-soft);
    display:grid;place-items:center;font-size:28px;margin-bottom:16px;
  }
  .modal h3{font-size:21px;margin:0 0 9px;letter-spacing:-.04em}
  .modal p{font-size:14px;line-height:1.65;color:var(--muted);margin:0}
  .modal-highlight{
    margin-top:15px;padding:14px 15px;border-radius:16px;
    background:#f3f1ff;color:#5d50c8;font-weight:900;
  }
  .modal-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:20px}
  .modal-actions.one{grid-template-columns:1fr}
  .modal-btn{
    height:49px;border-radius:15px;border:1px solid var(--line);
    background:#f5f5f8;color:#55596c;font-weight:850;cursor:pointer;
  }
  .modal-btn.primary{border:0;background:linear-gradient(135deg,var(--primary),#8f7eff);color:#fff}
  .loading-row{display:flex;align-items:center;gap:11px;margin-top:16px;color:#666a7d;font-size:13px;font-weight:750}
  .spinner{
    width:20px;height:20px;border-radius:50%;border:3px solid #e0def6;
    border-top-color:var(--primary);animation:spin .75s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}
  .extra-task{border-color:#c7c4d2;background:linear-gradient(135deg,#f0f0f3,#e7e8ed)}
  .extra-task .task-icon{background:#dedde6}


  body.theme-night{
    --bg:#252a35;
    --surface:#323844;
    --surface-soft:#2c323d;
    --text:#f1f3f7;
    --muted:#aeb5c1;
    --line:#454c59;
    --primary:#9b95c9;
    --primary-2:#858eb7;
    --primary-soft:#414556;
    --nav:#2c313c;
    --success:#76c6a9;
    --shadow:0 16px 40px rgba(0,0,0,.20);
  }
  body.theme-night .app{
    background:
      radial-gradient(circle at 12% 4%, rgba(113,109,150,.13), transparent 30%),
      radial-gradient(circle at 92% 9%, rgba(73,87,111,.13), transparent 25%),
      var(--bg);
  }
  body.theme-night .greeting{background:linear-gradient(135deg,#373d49,#303641 58%,#2c3440)}
  body.theme-night .bottom-nav{background:rgba(43,48,59,.96)}
  body.theme-night .icon-btn, body.theme-night .task-card, body.theme-night .work-panel-card,
  body.theme-night .mail-item, body.theme-night .file-item, body.theme-night .doc-box,
  body.theme-night .choice, body.theme-night .answer-input{background:#323844;color:var(--text)}
  body.theme-night .placeholder{background:#303641;border-color:#4a515e;color:#aeb5c1}
  .employee-search{display:flex;gap:8px;margin-top:12px}
  .employee-search input{flex:1;min-width:0}
  .search-btn{border:0;border-radius:14px;padding:0 15px;background:var(--primary-soft);color:var(--primary);font-weight:850}
  .empty-result{margin-top:12px;padding:15px;border:1px dashed var(--line);border-radius:16px;color:var(--muted);font-size:13px;line-height:1.6}
  .employee-card{margin-top:14px;padding:17px;border:1px solid var(--line);border-radius:18px;background:var(--surface-soft)}
  .employee-name{font-size:17px;font-weight:900}.employee-info{margin-top:8px;font-size:13px;color:var(--muted);line-height:1.7}
  .status-pill{display:inline-block;margin-left:5px;padding:4px 8px;border-radius:999px;background:#e8e7ef;color:#686579;font-size:11px;font-weight:900}
  body.theme-night .status-pill{background:#464c59;color:#d7dbe3}


  .report-note{padding:15px;border-radius:17px;background:var(--surface-soft);border:1px solid var(--line);font-size:13px;line-height:1.65;color:var(--muted)}
  .timeline-list{display:grid;gap:10px;margin-top:14px}
  .timeline-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 14px;border-radius:15px;background:var(--surface-soft);border:1px solid var(--line)}
  .timeline-row b{font-size:14px}.timeline-row span{font-size:12px;color:var(--muted);font-weight:800}
  .order-board{margin-top:16px;padding:14px;border-radius:18px;background:var(--surface-soft);border:1px solid var(--line)}
  .order-title{font-size:12px;font-weight:900;color:var(--muted);margin-bottom:10px}
  .order-slots{display:flex;gap:7px;flex-wrap:wrap;min-height:38px}
  .order-chip{padding:9px 11px;border-radius:12px;background:var(--primary-soft);color:var(--primary);font-size:12px;font-weight:900}
  .report-choices{display:grid;gap:9px;margin-top:14px}
  .report-choice{border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:14px;text-align:left;color:var(--text);font-weight:850}
  .report-choice.used{opacity:.38;pointer-events:none}
  .status-checks{display:grid;gap:9px;margin-top:16px}
  .status-line{padding:12px 14px;border-radius:14px;background:var(--surface-soft);border:1px solid var(--line);font-size:13px;font-weight:800}
  .status-line.pending{color:var(--muted)}
  .status-line.ok{color:var(--success)}
  .system-joke{margin-top:14px;padding:14px 15px;border-radius:16px;background:#3b3f4d;color:#e7e9f0;font-size:13px;line-height:1.65;border:1px solid #505666}


  .admin-gate{padding:16px;border:1px solid var(--line);border-radius:18px;background:var(--surface-soft)}
  .admin-code{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
  .admin-code input{height:52px;text-align:center;font-weight:900;font-size:20px;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--text);outline:none}
  .admin-code input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(155,149,201,.12)}
  .icon-seq{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:16px 0}
  .icon-token{width:54px;height:54px;border-radius:16px;background:var(--primary-soft);display:grid;place-items:center;font-size:25px;border:1px solid var(--line)}
  .arrow-token{color:var(--muted);font-weight:900}
  .admin-panel{margin-top:14px}
  .admin-title{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:900;margin-bottom:8px}
  .setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
  .setting-row:last-child{border-bottom:0}
  .setting-copy b{display:block;font-size:14px}.setting-copy span{display:block;margin-top:4px;font-size:12px;color:var(--muted);line-height:1.5}
  .toggle{min-width:58px;height:32px;border-radius:999px;background:#7b78a8;position:relative;border:0;cursor:pointer}
  .toggle:after{content:"";position:absolute;top:4px;right:4px;width:24px;height:24px;border-radius:50%;background:white;transition:.2s}
  .toggle.off{background:#59606d}
  .toggle.off:after{right:30px}
  .log-box{margin-top:16px;padding:14px;border-radius:16px;background:#292e38;border:1px solid #434a57;color:#dfe2e8;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.7}
  .log-line{display:flex;gap:10px}.log-time{color:#9199a8;min-width:42px}.log-em{color:#b8b2ef}
