<script>
(() => {
  const STORAGE_KEY = 'leaveWorkGame_v10';

  const loginScreen = document.getElementById('loginScreen');
  const homeScreen = document.getElementById('homeScreen');
  const nameInput = document.getElementById('nameInput');
  const loginBtn = document.getElementById('loginBtn');
  const playerName = document.getElementById('playerName');
  const avatar = document.getElementById('avatar');
  const toast = document.getElementById('toast');
  const endingScreen = document.getElementById('endingScreen');

  let toastTimer = null;

  const showToast = (msg) => {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 1800);
  };


  const modalOverlay = document.getElementById('modalOverlay');
  const modalCard = document.getElementById('modalCard');

  const applyTheme = (theme) => {
    document.body.classList.toggle('theme-evening', theme === 'evening');
    document.body.classList.toggle('theme-night', theme === 'night');
  };

  const closeModal = () => {
    modalOverlay.classList.remove('show');
    modalOverlay.setAttribute('aria-hidden','true');
  };

  const openModal = (html) => {
    modalCard.innerHTML = html;
    modalOverlay.classList.add('show');
    modalOverlay.setAttribute('aria-hidden','false');
  };

  const showCompletionModal = () => {
    const st = loadState();
    if(!st || st.completionAcknowledged) return;
    openModal(`
      <div class="modal-icon">⭐</div>
      <h3>오늘의 업무를 모두 완료했습니다!</h3>
      <p>수고하셨습니다.<br>모든 업무가 정상적으로 처리되었습니다.</p>
      <div class="modal-actions one">
        <button id="completionOk" class="modal-btn primary">확인</button>
      </div>`);
    document.getElementById('completionOk').onclick = () => {
      const state = loadState();
      state.completionAcknowledged = true;
      saveState(state);
      closeModal();
      renderHome(state);
      showToast('퇴근할 준비가 되었습니다.');
    };
  };

  const showCheckoutConfirm = () => {
    openModal(`
      <div class="modal-icon">🚪</div>
      <h3>퇴근하시겠습니까?</h3>
      <p>오늘 처리한 업무를 저장하고 퇴근을 진행합니다.</p>
      <div class="modal-actions">
        <button id="checkoutNo" class="modal-btn">아니오</button>
        <button id="checkoutYes" class="modal-btn primary">예</button>
      </div>`);
    document.getElementById('checkoutNo').onclick = closeModal;
    document.getElementById('checkoutYes').onclick = () => {
      modalCard.innerHTML = `
        <div class="modal-icon">⏳</div>
        <h3>퇴근 처리 중...</h3>
        <p>업무 기록과 퇴근 조건을 확인하고 있습니다.</p>
        <div class="loading-row"><span class="spinner"></span> 퇴근 가능 여부 확인 중</div>`;
      setTimeout(showFirstCheckoutFailure, 900);
    };
  };

  const showFirstCheckoutFailure = () => {
    const state = loadState();
    state.firstCheckoutFailed = true;
    state.extraTaskUnlocked = true;
    state.theme = 'evening';
    saveState(state);
    renderHome(state);

    modalCard.innerHTML = `
      <div class="modal-icon">⚠️</div>
      <h3>퇴근할 수 없습니다.</h3>
      <p>미처리된 업무가 있습니다.</p>
      <div class="modal-highlight">남은 업무 <b>1건</b></div>
      <p style="margin-top:14px">보다 원활한 퇴근을 위해<br>추가 업무가 배정되었습니다. 🙂</p>
      <div class="modal-actions one">
        <button id="checkExtraTask" class="modal-btn primary">업무 확인하기</button>
      </div>`;
    document.getElementById('checkExtraTask').onclick = () => {
      closeModal();
      renderHome(loadState());
      setTimeout(()=>document.getElementById('extraTaskCard')?.scrollIntoView({behavior:'smooth',block:'center'}),80);
    };
  };


  const shuffled = (arr) => {
    const a=[...arr];
    for(let i=a.length-1;i>0;i--){
      const j=Math.floor(Math.random()*(i+1));
      [a[i],a[j]]=[a[j],a[i]];
    }
    return a;
  };

  const makeRandomState = (player) => {
    const twoDigit = () => String(Math.floor(Math.random() * 90) + 10);
    const approvalPatterns = ['add','subtract','double','triple','stepUp'];
    const pattern = approvalPatterns[Math.floor(Math.random() * approvalPatterns.length)];
    return {
      version:'1.0',
      player,
