    panel.style.display='none';
    guideBox.style.display='block';
    closeModal();
    document.body.classList.remove('theme-evening','theme-night');
    nameInput.value='';
    document.getElementById('tomorrowToast').classList.remove('show');
    window.scrollTo({top:0,behavior:'smooth'});
  });

  document.getElementById('checkoutBtn').addEventListener('click', () => {
    const st = loadState();
    if(st?.systemResolved && !st?.finalCheckoutComplete) showFinalCheckoutConfirm();
    else if(st?.reportCompleted && !st?.secondCheckoutFailed) showSecondCheckoutConfirm();
    else showCheckoutConfirm();
  });

  // v1.0: 모바일/PC 반응형, 저장 복원, 랜덤 퍼즐, 전체 스토리 흐름을 포함한 최종본입니다.
  const existing = normalizeState(loadState());
  if(existing){
    saveState(existing);
    if(existing.finalCheckoutComplete || existing.currentView==='ending'){
      document.body.classList.remove('theme-evening','theme-night');
      loginScreen.classList.remove('active');
      homeScreen.classList.remove('active');
      endingScreen.classList.add('active');
      document.getElementById('tomorrowToast').classList.add('show');
    }else{
      enterHome(existing);
      const view=existing.currentView;
      setTimeout(()=>{
        if(view==='mail'||view==='approval'||view==='files') openPanel(view);
        else if(view==='handover' && existing.extraTaskUnlocked) openHandover();
        else if(view==='report' && existing.secondTaskUnlocked) openReport();
        else if(view==='system' && existing.thirdTaskUnlocked) openSystemTask();
      },50);
    }
  }else{
    applyTheme('day');
  }
})();
</script>
</body>
</html>
